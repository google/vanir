# Package containing all code extractors that find and download patches/source code for Vanir.

load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

py_library(
    name = "code_extractor_base",
    srcs = ["code_extractor_base.py"],
    deps = [
        "//:vulnerability",
        "@vanir_deps//requests",
        "@vanir_deps//unidiff",
    ],
)

py_library(
    name = "code_extractor",
    srcs = ["code_extractor.py"],
    deps = [
        ":code_extractor_android",
        ":code_extractor_base",
        ":code_extractor_git",
        "//:vulnerability",
    ],
)

py_library(
    name = "code_extractor_android",
    srcs = ["code_extractor_android.py"],
    deps = [
        ":code_extractor_base",
        ":git_commit",
        ":gitiles_commit",
        ":qualcomm_commit",
        "//:vulnerability",
    ],
)

py_library(
    name = "code_extractor_git",
    srcs = ["code_extractor_git.py"],
    deps = [
        ":code_extractor_base",
        ":git_commit",
        "//:vulnerability",
        "@ossf_osv_schema//:vulnerability_py_pb2",
    ],
)

py_test(
    name = "code_extractor_test",
    srcs = ["code_extractor_test.py"],
    data = [
        "//vanir/testdata:test_patch_set",
    ],
    deps = [
        ":code_extractor",
        ":code_extractor_android",
        ":code_extractor_base",
        ":code_extractor_git",
        "//:vulnerability",
        "@com_google_absl_py//absl/testing:absltest",
        "@com_google_absl_py//absl/testing:parameterized",
    ],
)

py_test(
    name = "code_extractor_android_test",
    srcs = ["code_extractor_android_test.py"],
    data = [
        "//vanir/testdata:test_patch_set",
    ],
    deps = [
        ":code_extractor_android",
        ":code_extractor_base",
        ":git_commit",
        ":gitiles_commit",
        ":qualcomm_commit",
        "//:vulnerability",
        "@com_google_absl_py//absl/testing:absltest",
        "@com_google_absl_py//absl/testing:parameterized",
    ],
)

py_test(
    name = "code_extractor_git_test",
    srcs = ["code_extractor_git_test.py"],
    data = [
        "//vanir/testdata:test_patch_set",
    ],
    deps = [
        ":code_extractor_base",
        ":code_extractor_git",
        ":git_commit",
        "//:vulnerability",
        "@com_google_absl_py//absl/testing:absltest",
        "@com_google_absl_py//absl/testing:parameterized",
    ],
)

py_library(
    name = "gitiles_commit",
    srcs = ["gitiles_commit.py"],
    deps = [
        ":code_extractor_base",
        "@vanir_deps//requests",
    ],
)

py_test(
    name = "gitiles_commit_test",
    srcs = ["gitiles_commit_test.py"],
    data = [
        "//vanir/testdata:test_patch_set",
    ],
    deps = [
        ":code_extractor_base",
        ":gitiles_commit",
        "//:file_path_utils",
        "@com_google_absl_py//absl/testing:absltest",
        "@com_google_absl_py//absl/testing:parameterized",
        "@vanir_deps//requests",
    ],
)

py_library(
    name = "qualcomm_commit",
    srcs = ["qualcomm_commit.py"],
    deps = [
        ":code_extractor_base",
        "@vanir_deps//requests",
    ],
)

py_test(
    name = "qualcomm_commit_test",
    srcs = ["qualcomm_commit_test.py"],
    data = [
        "//vanir/testdata:test_patch_set",
    ],
    deps = [
        ":code_extractor_base",
        ":qualcomm_commit",
        "//:file_path_utils",
        "@com_google_absl_py//absl/testing:absltest",
        "@com_google_absl_py//absl/testing:parameterized",
        "@vanir_deps//requests",
    ],
)

py_library(
    name = "git_commit",
    srcs = ["git_commit.py"],
    deps = [
        ":code_extractor_base",
        "@vanir_deps//tenacity",
    ],
)

py_test(
    name = "git_commit_test",
    srcs = ["git_commit_test.py"],
    data = ["//vanir/testdata:test_patch_set"],
    deps = [
        ":code_extractor_base",
        ":git_commit",
        "//:file_path_utils",
        "@com_google_absl_py//absl/testing:absltest",
        "@com_google_absl_py//absl/testing:parameterized",
        "@vanir_deps//tenacity",
    ],
)
