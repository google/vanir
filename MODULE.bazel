"""Vanir build and test dependencies."""

module(name = "vanir")

bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "rules_python", version = "1.8.4")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "abseil-cpp", version = "20260107.1", repo_name = "com_google_absl")
bazel_dep(name = "pybind11_bazel", version = "3.0.0")
bazel_dep(name = "rules_proto", version = "7.1.0")
# Pin protobuf to 33.4. Bumping to 35.0 (or newer) causes Kokoro CI failures
# because the managed image only provides Android SDK build tools version 33.0.0,
# whereas the newer rules_android version requested by protobuf 35.0+ requires
# version 35.0.0 or newer.
bazel_dep(name = "protobuf", version = "33.4", repo_name = "com_google_protobuf")
bazel_dep(name = "abseil-py", version = "2.4.0", repo_name = "com_google_absl_py")
SUPPORTED_PYTHON_VERSIONS = [
    "3.10",
    "3.11",
    "3.12",
    "3.13",
]

DEFAULT_PYTHON_VERSION = "3.10"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
[
    python.toolchain(
        is_default = version == DEFAULT_PYTHON_VERSION,
        python_version = version,
    )
    for version in SUPPORTED_PYTHON_VERSIONS
]
use_repo(python, python = "python_versions")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
[
    pip.parse(
        hub_name = "vanir_deps",
        python_version = version,
        requirements_lock = "//requirements:requirements_lock_" + version + ".txt",
    )
    for version in SUPPORTED_PYTHON_VERSIONS
]
use_repo(pip, "vanir_deps")

[
    pip.parse(
        hub_name = "antlr4_deps",
        python_version = version,
        requirements_lock = "//requirements:requirements_antlr4_lock_" + version + ".txt",
    )
    for version in SUPPORTED_PYTHON_VERSIONS
]
use_repo(pip, "antlr4_deps")

antlr4_grammar_java_lexer_g4_extension = use_extension("//:extensions.bzl", "antlr4_grammar_java_lexer_g4_extension")
use_repo(antlr4_grammar_java_lexer_g4_extension, "antlr4_grammar_java_lexer_g4")

antlr4_grammar_java_parser_g4_extension = use_extension("//:extensions.bzl", "antlr4_grammar_java_parser_g4_extension")
use_repo(antlr4_grammar_java_parser_g4_extension, "antlr4_grammar_java_parser_g4")

antlr4_runtimes_extension = use_extension("//:extensions.bzl", "antlr4_runtimes_extension")
use_repo(antlr4_runtimes_extension, "antlr4_runtimes")

fuzzyc_extension = use_extension("//:extensions.bzl", "fuzzyc_extension")
use_repo(fuzzyc_extension, "fuzzyc")

antlr4_entry_points_extension = use_extension("//:extensions.bzl", "antlr4_entry_points_extension")
use_repo(antlr4_entry_points_extension, "antlr4_entry_points")

pybind11_abseil_extension = use_extension("//:extensions.bzl", "pybind11_abseil_extension")
use_repo(pybind11_abseil_extension, "pybind11_abseil")

ossf_osv_schema_extension = use_extension("//:extensions.bzl", "ossf_osv_schema_extension")
use_repo(ossf_osv_schema_extension, "ossf_osv_schema")
