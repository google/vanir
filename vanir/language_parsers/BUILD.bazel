# Package containing all programming language parsers for Vanir.

load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

py_library(
    name = "abstract_language_parser",
    srcs = [
        "abstract_language_parser.py",
    ],
    deps = [
        ":common",
        "@com_google_absl_py//absl/logging",
    ],
)

py_library(
    name = "common",
    srcs = [
        "common.py",
    ],
)

py_library(
    name = "tree_sitter_base",
    srcs = [
        "tree_sitter_base.py",
    ],
    data = ["@pybind11_abseil//pybind11_abseil:status.so"],
    deps = [
        ":abstract_language_parser",
        ":common",
        "@com_google_absl_py//absl/logging",
        "@vanir_deps//tree_sitter",
    ],
)

py_library(
    name = "language_parsers",
    srcs = ["language_parsers.py"],
    deps = [
        ":abstract_language_parser",
        ":common",
        "//vanir/language_parsers/cpp:cpp_parser",
        "//vanir/language_parsers/java:java_parser",
    ],
)

py_test(
    name = "tree_sitter_base_test",
    size = "small",
    srcs = ["tree_sitter_base_test.py"],
    deps = [
        ":tree_sitter_base",
        "@com_google_absl_py//absl/testing:absltest",
        "@vanir_deps//tree_sitter",
        "@vanir_deps//tree_sitter_python",
    ],
)
