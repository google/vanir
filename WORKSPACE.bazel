# Protoc compiler binary for Linux x86_64
# This downloads a precompiled x86_64 Linux binary of protoc. If WORKSPACE
# (and not bzlmod) is used to build Vanir, the build must be performed on
# an x86_64 Linux system (and not aarch64, for example). For other platforms,
# Bzlmod can be used, which supports multi-platform toolchains.
http_archive(
    name = "com_google_protobuf_protoc_linux",
    build_file_content = """
filegroup(
    name = "protoc",
    srcs = ["bin/protoc"],
    visibility = ["//visibility:public"],
)
""",
    sha256 = "ed8fca87a11c888fed329d6a59c34c7d436165f662a2c875246ddb1ac2b6dd50",
    urls = ["https://github.com/protocolbuffers/protobuf/releases/download/v25.1/protoc-25.1-linux-x86_64.zip"],
)

# OSV schema
OSV_SCHEMA_REV = "a45f3f30f6a5490d198ebcaafef09078084da324"

http_archive(
    name = "ossf_osv_schema",
    build_file_content = """
package(default_visibility = ["//visibility:public"])

# Copy the proto file to 'osv/' so Python code can import it as
# 'from osv import vulnerability_pb2' (instead of 'from proto import ...').
genrule(
    name = "copy_proto",
    srcs = ["proto/vulnerability.proto"],
    outs = ["osv/vulnerability.proto"],
    cmd = "cp $< $@",
)

# Compile using the protoc compiler
genrule(
    name = "vulnerability_py_pb2_gen",
    srcs = [":copy_proto"],
    outs = ["osv/vulnerability_pb2.py"],
    cmd = "$(execpath @com_google_protobuf_protoc_linux//:protoc) --python_out=$(@D)/.. -I$$(dirname $$(dirname $<)) $<",
    tools = ["@com_google_protobuf_protoc_linux//:protoc"],
)

# Wrap it in a py_library that depends on the protobuf PyPI package directly
py_library(
    name = "vulnerability_py_pb2",
    srcs = [":vulnerability_py_pb2_gen"],
    deps = [
        "@vanir_deps_protobuf//:pkg",
    ],
    # Add the repository root to Python's path so that dependent targets can import
    # 'from osv import vulnerability_pb2' directly.
    imports = ["."],
    visibility = ["//visibility:public"],
)
""",
    sha256 = "c0aab67b3cb626d6c1595c4ffb06cfc6d1b6f86f55ca0da1578c5fc40734be19",
    strip_prefix = "osv-schema-%s" % OSV_SCHEMA_REV,
    urls = ["https://github.com/ossf/osv-schema/archive/%s.tar.gz" % OSV_SCHEMA_REV],
)

